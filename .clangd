CompileFlags:
  CompilationDatabase: .
  Add:
    - -isystem
    - /home/acollado/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/c++/8.4.0
    - -isystem
    - /home/acollado/.platformio/packages/toolchain-xtensa-esp33/xtensa-esp32-elf/include/c++/8.4.0/xtensa-esp32-elf
    - -isystem
    - /home/acollado/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/8.4.0/include
    - -isystem
    - /home/acollado/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/8.4.0/include-fixed
    - -isystem
    - /home/acollado/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include
    - -DESP32
    - -DARDUINO_ARCH_ESP32
    - -DARDUINO=10812
    - -D_GNU_SOURCE
    - -DF_CPU=240000000L
  Remove:
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -fno-jump-tables
    
Index:
  Background: Build

Diagnostics:
  Suppress:
    - "typedef_redefinition"
    - "redefinition_different_typedef"
    - "unknown_argument"
    - "undeclared_var_use"
    - "pp_including_mainfile_in_preamble"

